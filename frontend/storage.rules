rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public reading of meal and proof images
      allow read: if true;
      
      // Allow writes only by authenticated users, with < 5MB file size limit and image mime-type
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
